/* pages/protect/protect.wxss */
page {
  background-color: transparent;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.container {
  padding: 40rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.header {
  margin-bottom: 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #1976D2;
}

.subtitle {
  font-size: 28rpx;
  color: #64B5F6;
  margin-top: 10rpx;
}

.stats-card {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 10rpx 30rpx rgba(25, 118, 210, 0.15);
  margin-top: 30rpx;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #007AFF;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.stat-btn {
  font-size: 24rpx;
  color: #fff;
  background: #FFA000;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 10rpx rgba(255, 160, 0, 0.3);
}

.game-list {
  flex: 1;
}

.game-card {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.2s;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.game-card:active {
  transform: scale(0.98);
}

.game-icon {
  font-size: 60rpx;
  margin-right: 30rpx;
  background: #F5F5F5;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.game-info {
  flex: 1;
}

.game-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.level-tag {
  font-size: 20rpx;
  background: #E3F2FD;
  color: #1976D2;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  margin-left: 10rpx;
}

.game-desc {
  font-size: 24rpx;
  color: #888;
  margin-top: 10rpx;
}

.play-btn {
  font-size: 26rpx;
  color: white;
  background: #007AFF;
  padding: 12rpx 30rpx;
  border-radius: 30rpx;
  font-weight: bold;
}

/* 游戏区域 */
.game-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(15px);
  border-radius: 30rpx;
  padding: 30rpx;
  box-shadow: 0 10rpx 40rpx rgba(25, 118, 210, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.game-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.back-btn {
  font-size: 28rpx;
  color: #007AFF;
  font-weight: bold;
}

.timer {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF3B30;
}

.game-title {
  font-size: 40rpx;
  text-align: center;
  font-weight: bold;
  margin: 30rpx 0;
  color: #333;
}

.game-stage {
  flex: 1;
  background: #F0F8FF;
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
  border: 4rpx dashed #BBDEFB;
  box-shadow: inset 0 0 40rpx rgba(25, 118, 210, 0.05);
}

.voice-guide {
  text-align: center;
  font-size: 30rpx;
  color: #1976D2;
  margin: 20rpx 0;
  font-weight: bold;
  background: #E3F2FD;
  padding: 20rpx;
  border-radius: 40rpx;
}

.game-controls {
  margin-top: 20rpx;
}

.control-btn {
  background: linear-gradient(135deg, #007AFF, #00C6FF);
  color: white;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx rgba(0, 122, 255, 0.3);
  border: none;
}

/* 游戏卡片色彩区分 */
.game-card.track { border-left: 10rpx solid #FF7043; }
.game-card.focus { border-left: 10rpx solid #66BB6A; }
.game-card.rotate { border-left: 10rpx solid #5C6BC0; }

/* --- 游戏动画 --- */

/* 1. 眼球追踪 (移动) */
.star {
  font-size: 80rpx;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.star.moving {
  animation: trackMove 6s ease-in-out infinite alternate;
}

@keyframes trackMove {
  0% { left: 10%; top: 10%; }
  25% { left: 90%; top: 10%; }
  50% { left: 90%; top: 80%; }
  75% { left: 10%; top: 80%; }
  100% { left: 10%; top: 10%; }
}

/* 2. 远近调节 (缩放) */
.balloon {
  font-size: 120rpx;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(1);
}

.balloon.scaling {
  animation: focusScale 4s ease-in-out infinite alternate;
}

@keyframes focusScale {
  0% { transform: translate(-50%, -50%) scale(0.3); opacity: 0.6; }
  100% { transform: translate(-50%, -50%) scale(2.5); opacity: 1; }
}

/* 3. 眼球转动 (旋转) */
.windmill-container {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 200rpx;
  height: 200rpx;
  margin-top: -100rpx;
  margin-left: -100rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.windmill {
  font-size: 150rpx;
}

.windmill.rotating {
  animation: rotateSpin 3s linear infinite;
}

@keyframes rotateSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}