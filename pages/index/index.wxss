/* pages/index/index.wxss */
/* 动画基础配置 */
.container {
  padding: 60rpx 40rpx;
  background-color: transparent;
  min-height: 100vh;
  overflow-x: hidden; /* 防止飞入动画产生横向滚动条 */
  position: relative;
}

/* 语言切换样式 */
.top-bar {
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  z-index: 100;
}

.user-entry {
  background: rgba(255, 255, 255, 0.8);
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #3d8eff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.lang-switch {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(255, 255, 255, 0.8);
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #718096;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.lang-switch text.active {
  color: #007AFF;
  font-weight: bold;
}

.lang-switch .divider {
  color: #e2e8f0;
  margin: 0 4rpx;
}

/* 动画播放状态控制 */
.playing [class*="fly-in-"] {
  animation-play-state: running;
}

.paused [class*="fly-in-"] {
  animation-play-state: paused;
}

/* 核心飞入动画定义 */
[class*="fly-in-"] {
  opacity: 0;
  animation-duration: 1000ms;
  animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1); /* 缓动函数，流畅自然 */
  animation-fill-mode: forwards;
  animation-play-state: running;
}

/* 延迟档位 */
.delay-1 { animation-delay: 200ms; }
.delay-2 { animation-delay: 400ms; }
.delay-3 { animation-delay: 600ms; }
.delay-4 { animation-delay: 800ms; }

/* 8个方向的 Keyframes */
@keyframes flyInTop {
  from { transform: translateY(-200rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
@keyframes flyInBottom {
  from { transform: translateY(200rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
@keyframes flyInLeft {
  from { transform: translateX(-200rpx); opacity: 0; }
  to { transform: translateX(0); opacity: 1; }
}
@keyframes flyInRight {
  from { transform: translateX(200rpx); opacity: 0; }
  to { transform: translateX(0); opacity: 1; }
}
@keyframes flyInTopLeft {
  from { transform: translate(-200rpx, -200rpx); opacity: 0; }
  to { transform: translate(0, 0); opacity: 1; }
}
@keyframes flyInTopRight {
  from { transform: translate(200rpx, -200rpx); opacity: 0; }
  to { transform: translate(0, 0); opacity: 1; }
}
@keyframes flyInBottomLeft {
  from { transform: translate(-200rpx, 200rpx); opacity: 0; }
  to { transform: translate(0, 0); opacity: 1; }
}
@keyframes flyInBottomRight {
  from { transform: translate(200rpx, 200rpx); opacity: 0; }
  to { transform: translate(0, 0); opacity: 1; }
}

/* 分配动画到具体类 */
.fly-in-top { animation-name: flyInTop; }
.fly-in-bottom { animation-name: flyInBottom; }
.fly-in-left { animation-name: flyInLeft; }
.fly-in-right { animation-name: flyInRight; }
.fly-in-top-left { animation-name: flyInTopLeft; }
.fly-in-top-right { animation-name: flyInTopRight; }
.fly-in-bottom-left { animation-name: flyInBottomLeft; }
.fly-in-bottom-right { animation-name: flyInBottomRight; }

/* 调试控制样式 */
.debug-controls {
  position: fixed;
  bottom: 120rpx;
  right: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  z-index: 100;
}

/* 字体破碎粒子系统样式 */
.shatter-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: 200;
  display: none;
}

.shatter-overlay.active {
  display: block;
}

.particle {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  opacity: 0;
  box-shadow: 0 0 10rpx rgba(0, 0, 0, 0.1);
}

.particle.rect { border-radius: 2rpx; }
.particle.circle { border-radius: 50%; }

/* 破碎与重组动画：向外扩散再向中心聚集 */
.active .particle {
  animation: shatterAndRegroup 1200ms cubic-bezier(0.45, 0.05, 0.55, 0.95) forwards;
}

@keyframes shatterAndRegroup {
  0% {
    transform: translate(0, 0) rotate(0deg) scale(0);
    opacity: 0;
  }
  15% {
    opacity: 1;
    transform: translate(0, 0) rotate(0deg) scale(1.2);
  }
  50% {
    transform: translate(var(--tx), var(--ty)) rotate(var(--rot)) scale(1);
    opacity: 0.8;
  }
  85% {
    opacity: 1;
    transform: translate(0, 0) rotate(0deg) scale(1.2);
  }
  100% {
    transform: translate(0, 0) rotate(0deg) scale(0);
    opacity: 0;
  }
}

/* 主内容在破碎时的状态 */
.main-content {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: opacity 300ms ease;
}

.main-content.shattered {
  opacity: 0;
  pointer-events: none;
}

.title-group {
  margin-top: 60rpx;
  margin-bottom: 80rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
  border-radius: 50%; /* 保证圆润的图标 */
  background: transparent;
  display: block;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.main-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.sub-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.info-card {
  width: 100%;
  margin-bottom: 80rpx;
}

.mode-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #EAF3FF;
  color: #007AFF;
  font-size: 24rpx;
  font-weight: 600;
}

.info-item {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  font-size: 28rpx;
  color: #666;
}

.info-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  background: #E6F0FF;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.info-icon::after {
  content: "•";
  color: #007AFF;
}

.highlight {
  color: #007AFF;
  font-weight: bold;
}

.button-group {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
}

.menu-btn {
  width: 80% !important;
  font-weight: bold;
  color: #000000 !important; /* 恢复原来的蓝色文字样式 */
  border: none !important; /* 移除外边框 */
}

/* 覆盖全局样式中的透明填充，强制为白色填充底色 */
.menu-btn::after {
  background: #ffffff !important; /* 纯白色底色 */
  box-shadow: none !important;
  opacity: 1 !important; /* 确保不透明 */
  z-index: -1;
}

.footer {
  margin-top: 120rpx; /* 往下放两行左右的间距，原本是 auto */
  font-size: 22rpx;
  color: #CCC;
  text-align: center;
  padding-bottom: 60rpx;
}
