/* pages/color-train/color-train.wxss */
page {
  background-color: transparent;
  height: 100vh;
}

.container {
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  height: 100%;
  box-sizing: border-box;
}

/* Header & Mode Selector */
.header {
  margin-bottom: 30rpx;
}

.mode-selector {
  margin-bottom: 20rpx;
}

.selector-title {
  font-size: 24rpx;
  color: #718096;
  margin-bottom: 10rpx;
}

.type-scroll {
  white-space: nowrap;
}

.type-chip {
  display: inline-block;
  padding: 10rpx 30rpx;
  background: #edf2f7;
  color: #4a5568;
  border-radius: 30rpx;
  font-size: 24rpx;
  margin-right: 16rpx;
  transition: all 0.3s;
}

.type-chip.active {
  background: #007aff;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 122, 255, 0.3);
}

.stats-bar {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  border-radius: 24rpx;
  padding: 24rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.stat-item {
  display: flex;
  flex-direction: column;
}

.stat-item .label {
  font-size: 20rpx;
  color: #a0aec0;
}

.stat-item .value {
  font-size: 32rpx;
  font-weight: bold;
  color: #2d3748;
}

.report-icon {
  font-size: 40rpx;
}

/* Game Menu */
.game-menu {
  flex: 1;
}

.menu-card {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  border-radius: 30rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.menu-icon {
  font-size: 60rpx;
  margin-right: 30rpx;
}

.menu-info {
  flex: 1;
}

.menu-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #2d3748;
}

.menu-desc {
  font-size: 22rpx;
  color: #718096;
  margin-top: 6rpx;
}

.difficulty-dots {
  display: flex;
  gap: 8rpx;
  margin-top: 12rpx;
}

.difficulty-dots .dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #e2e8f0;
}

.difficulty-dots .dot.active {
  background: #ffae00;
}

.enter-arrow {
  color: #cbd5e0;
  font-size: 40rpx;
}

/* Game Stage */
.game-stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(15px);
  border-radius: 40rpx;
  padding: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.stage-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.back-btn {
  font-size: 26rpx;
  color: #007aff;
}

.timer {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff3b30;
}

.guide-text {
  margin-top: 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #4a5568;
  background: #f7fafc;
  padding: 20rpx;
  border-radius: 20rpx;
}

/* Game 1: Odd One Out */
.grid {
  display: grid;
  gap: 15rpx;
  width: 100%;
  aspect-ratio: 1;
}

.grid-item {
  width: 100%;
  height: 100%;
  transition: transform 0.1s;
}

.grid-item:active {
  transform: scale(0.9);
}

/* Game 2: Memory */
.memory-grid {
  display: grid;
  gap: 20rpx;
  width: 100%;
}

.card {
  aspect-ratio: 1;
  position: relative;
  transform-style: preserve-3d;
  transition: transform 0.5s;
}

.card.flipped {
  transform: rotateY(180deg);
}

.card.matched {
  opacity: 0.3;
}

.card-front, .card-back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 16rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.card-front {
  transform: rotateY(180deg);
}

.card-back {
  background: #edf2f7;
  color: #a0aec0;
  font-size: 40rpx;
}

/* Game 3: Sort */
.sort-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin: 40rpx 0;
}

.sort-item {
  height: 100rpx;
  border-radius: 16rpx;
  transition: all 0.2s;
}

.sort-item.selected {
  border: 6rpx solid #007aff;
  transform: scale(1.02);
}

.confirm-btn {
  background: #007aff;
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  margin-top: auto;
}