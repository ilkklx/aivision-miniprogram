/* pages/result/result.wxss */
.container {
  padding: 40rpx;
  background-color: transparent;
  min-height: 100vh;
  position: relative;
}

.lang-switch-fixed {
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.8);
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #718096;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.lang-switch-fixed text.active {
  color: #007AFF;
  font-weight: bold;
}

.lang-switch-fixed .divider {
  color: #e2e8f0;
}

.result-card {
  background-color: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  border-radius: 40rpx;
  padding: 60rpx 40rpx;
  margin-bottom: 60rpx;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.1);
  display: flex;
  flex-direction: column;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.result-title {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.result-value {
  font-size: 120rpx;
  font-weight: bold;
  color: #007AFF;
  margin-bottom: 10rpx;
}

.result-value .unit {
  font-size: 40rpx;
  margin-left: 10rpx;
  color: #333;
}

.result-label {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.divider {
  height: 2rpx;
  background: #eee;
  margin: 40rpx 0;
}

.info-list {
  text-align: left;
}

.info-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.info-item .label {
  color: #666;
  font-size: 28rpx;
}

.info-item .value {
  color: #333;
  font-size: 28rpx;
  font-weight: 500;
}

.analysis-box {
  margin-top: 40rpx;
  background: #F0F7FF;
  padding: 30rpx;
  border-radius: 20rpx;
  text-align: left;
}

.analysis-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #007AFF;
  margin-bottom: 10rpx;
}

.analysis-content {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
}

.btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background: #007AFF;
  color: #fff;
}

.btn-outline {
  background: #fff;
  color: #007AFF;
  border: 2rpx solid #007AFF;
}

.footer-tip {
  margin-top: auto;
  font-size: 24rpx;
  color: #999;
  text-align: center;
  padding: 40rpx 0;
}
