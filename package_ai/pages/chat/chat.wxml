<view class="chat-container">
  <scroll-view
    class="message-list"
    scroll-y
    scroll-into-view="{{scrollToView}}"
    scroll-with-animation
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="welcome-section" wx:if="{{messages.length === 0}}">
      <image class="welcome-avatar" src="/package_ai/assets/images/float-ball.png" mode="aspectFit"></image>
      <text class="welcome-title">{{t.chat.welcomeTitle}}</text>
      <text class="welcome-desc">{{t.chat.welcomeDesc}}</text>
      <view class="quick-questions">
        <view
          class="quick-q-item"
          wx:for="{{quickQuestions}}"
          wx:key="index"
          bindtap="onQuickQuestion"
          data-text="{{item}}"
        >
          <text>{{item}}</text>
        </view>
      </view>
    </view>

    <view class="message-item {{item.role}}-msg" wx:for="{{messages}}" wx:key="id">
      <view class="msg-avatar">
        <image
          wx:if="{{item.role === 'assistant'}}"
          class="avatar-img"
          src="/package_ai/assets/images/float-ball.png"
          mode="aspectFit"
        ></image>
        <view wx:else class="avatar-img user-avatar">
          <text class="avatar-text">我</text>
        </view>
      </view>
      <view class="msg-content-wrap">
        <view class="msg-bubble {{item.role}}-bubble">
          <text class="msg-text" user-select>{{item.content}}</text>
        </view>
        <text class="msg-time">{{item.time}}</text>
      </view>
    </view>

    <view class="typing-indicator" wx:if="{{isLoading && messages.length > 0 && !(messages[messages.length-1]._streaming)}}">
      <view class="msg-avatar">
        <image class="avatar-img" src="/package_ai/assets/images/float-ball.png" mode="aspectFit"></image>
      </view>
      <view class="msg-content-wrap">
        <view class="msg-bubble assistant-bubble typing-bubble">
          <view class="typing-dots">
            <view class="dot dot-1"></view>
            <view class="dot dot-2"></view>
            <view class="dot dot-3"></view>
          </view>
        </view>
      </view>
    </view>

    <view id="msg-bottom" style="height: 20rpx;"></view>
  </scroll-view>

  <view class="input-area {{isVoiceMode ? 'voice-mode' : ''}}">
    <view class="input-row">
      <view class="mode-switch" bindtap="toggleInputMode">
        <text class="mode-icon">{{isVoiceMode ? '⌨️' : '🎤'}}</text>
      </view>

      <block wx:if="{{!isVoiceMode}}">
        <input
          class="text-input"
          value="{{inputValue}}"
          placeholder="{{t.chat.inputPlaceholder}}"
          placeholder-class="input-placeholder"
          confirm-type="send"
          bindinput="onInput"
          bindconfirm="sendMessage"
          disabled="{{isLoading}}"
          adjust-position="{{true}}"
          cursor-spacing="20"
        />
        <view class="send-btn {{inputValue.trim() && !isLoading ? 'active' : ''}}" bindtap="sendMessage">
          <text class="send-icon">➤</text>
        </view>
      </block>

      <block wx:else>
        <view
          class="voice-btn {{isRecording ? 'recording' : ''}}"
          bindtouchstart="onVoiceStart"
          bindtouchend="onVoiceEnd"
          bindtouchcancel="onVoiceCancel"
        >
          <text class="voice-btn-text">{{isRecording ? t.chat.releaseToSend : t.chat.holdToSpeak}}</text>
        </view>
      </block>
    </view>
  </view>

  <view class="clear-btn" bindtap="clearChat" wx:if="{{messages.length > 0}}">
    <text>🗑</text>
  </view>
</view>
