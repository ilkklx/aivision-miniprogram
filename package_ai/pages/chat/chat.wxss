.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #F5F7FA;
}

.message-list {
  flex: 1;
  padding: 20rpx 24rpx;
  padding-bottom: 20rpx;
}

.welcome-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 40rpx;
}

.welcome-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(61, 142, 255, 0.3);
}

.welcome-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.welcome-desc {
  font-size: 26rpx;
  color: #888;
  text-align: center;
  margin-bottom: 40rpx;
}

.quick-questions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}

.quick-q-item {
  padding: 14rpx 28rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #3d8eff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(61, 142, 255, 0.2);
}

.quick-q-item:active {
  background: #EAF3FF;
  transform: scale(0.96);
}

.message-item {
  display: flex;
  margin-bottom: 28rpx;
  animation: msgFadeIn 0.3s ease-out;
}

@keyframes msgFadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.user-msg {
  flex-direction: row-reverse;
}

.msg-avatar {
  flex-shrink: 0;
  margin: 0 16rpx;
}

.avatar-img {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #E6F0FF;
}

.user-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #3d8eff, #5ac8fa);
}

.avatar-text {
  font-size: 22rpx;
  color: #FFF;
  font-weight: bold;
}

.msg-content-wrap {
  max-width: 70%;
}

.msg-bubble {
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.assistant-bubble {
  background: #FFFFFF;
  color: #333;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.user-bubble {
  background: linear-gradient(135deg, #3d8eff, #2a75e6);
  color: #FFFFFF;
  border-top-right-radius: 4rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 142, 255, 0.3);
}

.msg-text {
  font-size: 28rpx;
  line-height: 1.6;
}

.msg-time {
  font-size: 20rpx;
  color: #BBB;
  margin-top: 6rpx;
  display: block;
}

.user-msg .msg-time {
  text-align: right;
}

.typing-indicator {
  display: flex;
  margin-bottom: 28rpx;
}

.typing-bubble {
  padding: 24rpx 32rpx;
}

.typing-dots {
  display: flex;
  gap: 8rpx;
  align-items: center;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #3d8eff;
  animation: dotBounce 1.2s ease-in-out infinite;
}

.dot-1 { animation-delay: 0s; }
.dot-2 { animation-delay: 0.2s; }
.dot-3 { animation-delay: 0.4s; }

@keyframes dotBounce {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  30% {
    transform: translateY(-12rpx);
    opacity: 1;
  }
}

.input-area {
  flex-shrink: 0;
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #F0F0F0;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.mode-switch {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F5F7FA;
  flex-shrink: 0;
}

.mode-switch:active {
  background: #E6F0FF;
}

.mode-icon {
  font-size: 32rpx;
}

.text-input {
  flex: 1;
  height: 72rpx;
  background: #F5F7FA;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #333;
}

.input-placeholder {
  color: #BBB;
  font-size: 26rpx;
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #E0E0E0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.3s;
}

.send-btn.active {
  background: linear-gradient(135deg, #3d8eff, #2a75e6);
  box-shadow: 0 4rpx 16rpx rgba(61, 142, 255, 0.4);
}

.send-icon {
  font-size: 32rpx;
  color: #FFF;
  transform: rotate(-30deg);
}

.voice-btn {
  flex: 1;
  height: 72rpx;
  background: #F5F7FA;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.voice-btn.recording {
  background: linear-gradient(135deg, #FF6B6B, #FF3B30);
}

.voice-btn-text {
  font-size: 26rpx;
  color: #666;
}

.voice-btn.recording .voice-btn-text {
  color: #FFF;
}

.clear-btn {
  position: fixed;
  top: 20rpx;
  right: 20rpx;
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
  z-index: 10;
  font-size: 28rpx;
}

.clear-btn:active {
  transform: scale(0.9);
}
