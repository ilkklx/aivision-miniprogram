.greeting-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.3);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.greeting-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.greeting-card {
  width: 80%;
  max-width: 600rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: cardPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes cardPop {
  from { transform: scale(0.8) translateY(40rpx); opacity: 0; }
  to { transform: scale(1) translateY(0); opacity: 1; }
}

.greeting-avatar-wrap {
  position: relative;
  margin-bottom: 32rpx;
}

.greeting-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(61, 142, 255, 0.3);
}

.avatar-pulse {
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(61, 142, 255, 0.4);
  animation: pulseRing 2s ease-out infinite;
}

@keyframes pulseRing {
  0% { transform: scale(1); opacity: 1; }
  100% { transform: scale(1.4); opacity: 0; }
}

.greeting-content {
  text-align: center;
  min-height: 80rpx;
  margin-bottom: 24rpx;
}

.greeting-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.7;
  word-break: break-all;
}

.typing-cursor {
  display: inline;
  font-size: 30rpx;
  color: #3d8eff;
  animation: blink 0.8s step-end infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.greeting-actions {
  margin-top: 16rpx;
}

.action-btn {
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #3d8eff, #2a75e6);
  color: #FFF;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(61, 142, 255, 0.4);
}

.action-btn:active {
  transform: scale(0.95);
}
